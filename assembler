#!/usr/bin/env python3

from typing import NamedTuple
import re
from enum import Enum
from itertools import tee
from ctypes import c_uint16, c_int8
from sys import argv

class Token(NamedTuple):
    type: str
    value: str
    line: int
    column: int

def tokenize(code, instructions, pseudo_instructions, registers):
    token_specification = [
        ('COMMENT', r'#[^\n]*'),
        ('HEX_NUM', r'0x[0-9a-fA-F]+'),
        ('BIN_NUM', r'0b[01]+'),
        ('NEG_DEC_NUM', r'-[0-9]+'),
        ('DEC_NUM', r'[0-9]+'),
        ('LABEL', r'[a-zA-Z0-9_]+:'),
        ('DIRECTIVE', r'\.[a-zA-Z0-9_]+'),
        ('ID', r'[a-zA-Z0-9_]+'),
        ('NEWLINE', r'\n'),
        ('EMPTY', r'[ \t]+'),
        ('ANY', r'.')
    ]

    token_regex = '|'.join('(?P<%s>%s)' % pair for pair in token_specification)

    line_num = 1
    line_start = 0

    for lexeme in re.finditer(token_regex, code):
        kind = lexeme.lastgroup
        value = lexeme.group()
        column = lexeme.start() - line_start

        if kind == 'ID' and value in instructions:
            kind = 'INSTRUCTION'
        elif kind == 'ID' and value in pseudo_instructions:
            kind = 'PSEUDO_INSTRUCTION'
        elif kind == 'ID' and value in registers:
            kind = 'REGISTER'
        elif kind == 'LABEL':
            value = value[:-1]
        elif kind == 'DIRECTIVE':
            value = value[1:]
        elif kind == 'HEX_NUM':
            kind = 'NUMBER'
            value = int(value, 16)
        elif kind == 'NEG_DEC_NUM':
            kind = 'NUMBER'
            value = int(value, 10)
        elif kind == 'DEC_NUM':
            kind = 'NUMBER'
            value = int(value, 10)
        elif kind == 'BIN_NUM':
            kind = 'NUMBER'
            value = int(value, 2)
        elif kind == 'COMMENT':
            continue
        elif kind == 'NEWLINE':
            line_start = lexeme.end()
            line_num += 1
            continue
        elif kind == 'EMPTY':
            continue
        elif kind == 'ANY':
            raise RuntimeError(f'"{value}" invalid on line {line_num}')

        yield Token(kind, value, line_num, column)

    yield Token('END', '', line_num, column)

def read_file(path):
    with open(path, 'r') as file:
        return file.read()

    return ''

def generate_symbol_table(tokens, pseudo_instructions):
    symbol_table = {}
    current_address = 0

    current_token = next(tokens)

    while current_token.type != 'END':
        match current_token.type:
            case 'LABEL':
                symbol_table[current_token.value] = current_address
                current_token = next(tokens)
            case 'INSTRUCTION':
                current_address += 1
                current_token = next(tokens)
            case 'PSEUDO_INSTRUCTION':
                current_address += pseudo_instructions[current_token.value]
                current_token = next(tokens)
            case 'DIRECTIVE':
                match current_token.value:
                    case 'DEF':
                        symbol_id = next(tokens).value
                        symbol_value = next(tokens).value
                        symbol_table[symbol_id] = symbol_value
                        current_token = next(tokens)
                    case 'RESERVE':
                        current_address += next(tokens).value
                        current_token = next(tokens)
                    case _:
                        current_token = next(tokens)
            case _:
                current_token = next(tokens)

    return symbol_table

def generate_program(tokens, symbol_table, instructions, pseudo_instructions, registers):
    program = []
    current_address = 0

    current_token = next(tokens)

    while current_token.type != 'END':
        match current_token.type:
            case 'LABEL':
                current_token = next(tokens)
            case 'DIRECTIVE':
                match current_token.value:
                    case 'DEF':
                        next(tokens)
                        next(tokens)
                        current_token = next(tokens)
                    case 'RESERVE':
                        for i in range(next(tokens).value):
                            program.append(instructions['NOP'])
                            current_address += 1

                        current_token = next(tokens)
                    case _:
                        raise RuntimeError(
                            f'"{current_token.value}({current_token.type})"'
                            + f' invalid directive on line {current_token.line}'
                        )
            case 'INSTRUCTION' | 'PSEUDO_INSTRUCTION':
                match current_token.value:
                    case 'NOP':
                        program.append(instructions['NOP'])
                        current_address += 1
                        current_token = next(tokens)
                    case 'LDHI':
                        program.append(
                            instructions['LDHI']
                            | registers[next(tokens).value] << 8
                            | next(tokens).value
                        )
                        current_address += 1
                        current_token = next(tokens)
                    case 'LDLI':
                        program.append(
                            instructions['LDLI']
                            | registers[next(tokens).value] << 8
                            | next(tokens).value
                        )
                        current_address += 1
                        current_token = next(tokens)
                    case 'ADDI':
                        program.append(
                            instructions['ADDI']
                            | registers[next(tokens).value] << 8
                            | (next(tokens).value & 0x00ff)
                        )
                        current_address += 1
                        current_token = next(tokens)
                    case 'JUMP':
                        program.append(
                            instructions['JUMP']
                            | symbol_table[next(tokens).value]
                        )
                        current_address += 1
                        current_token = next(tokens)
                    case 'LDI':
                        register = registers[next(tokens).value]
                        value = 0

                        value_token = next(tokens)
                        match value_token.type:
                            case 'ID':
                                value = symbol_table[value_token.value]
                            case 'NUMBER':
                                value = value_token.value
                            case _:
                                raise RuntimeError(
                                    f'"{value_token.value}({value_token.type})"'
                                    + f' invalid token on line {value_token.line}'
                                )

                        program.append(
                            instructions['LDHI']
                            | register << 8
                            | (value & 0xff00) >> 8
                        )

                        program.append(
                            instructions['LDLI']
                            | register << 8
                            | value & 0x00ff
                        )

                        current_address += 2
                        current_token = next(tokens)
            case _:
                raise RuntimeError(
                    f'"{current_token.value}({current_token.type})"'
                    + f' invalid token on line {current_token.line}'
                )

    return program

def write_program_file(path, program):
    with open(path, 'wb') as file:
        for value in program:
            file.write(c_uint16(value))

if len(argv) < 3:
    print(f'Usage: {argv[0]} [input path] [output path]')
    exit(1)

# name: value
instructions = {
    'NOP':  0 << 11,
    'LDHI': 1 << 11,
    'LDLI': 2 << 11,
    'ADDI': 3 << 11,
    'JUMP': 4 << 11
}

# name: instruction count
pseudo_instructions = {
    'LDI': 2
}

# name: value
registers = {
    'R1': 0,
    'R2': 1,
    'R3': 2,
    'R4': 3,
    'R5': 4,
    'R6': 5,
    'R7': 6,
    'R8': 7
}

src = read_file(argv[1])

symbol_tokens, program_tokens = tee(
    tokenize(src, instructions, pseudo_instructions, registers),
    2
)

symbol_table = generate_symbol_table(symbol_tokens, pseudo_instructions)
program = generate_program(program_tokens, symbol_table, instructions, pseudo_instructions, registers)

write_program_file(argv[2], program)

print('=== Symbol Table ===')
for symbol, value in symbol_table.items():
    print(f'{symbol} = {value}')

print('=== Program Memory ===')
for value in program:
    print(f'0x{format(value, '04x')} = 0b{format(value, '016b')}')
